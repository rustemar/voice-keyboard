<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/txtDictionaryHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vocabulary_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:text="@string/dictionary_recognition_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/status_text"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editVocabularyWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/vocabulary_input_hint"
        android:minHeight="48dp"
        android:inputType="textNoSuggestions"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/status_text"
        android:backgroundTint="@color/mic_idle" />

    <Button
        android:id="@+id/btnVocabularyAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/vocabulary_add"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:backgroundTint="@color/mic_idle" />

    <TextView
        android:id="@+id/txtVocabularyCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/status_text"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtVocabularyEmpty"
        android:text="@string/vocabulary_empty"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/status_text"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />
</LinearLayout>
